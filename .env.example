# Если значение содержит $, заключите все значение в одинарные кавычки.
DJANGO_SECRET_KEY=generate-a-unique-production-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=gym.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://gym.example.com,localhost
SECURE_COOKIES=1
SECURE_HSTS_SECONDS=31536000
APP_TIME_ZONE=Asia/Yekaterinburg
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=gym@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=gym@example.com
