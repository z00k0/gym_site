limit_req_zone $binary_remote_addr zone=gym_auth:10m rate=10r/m;

server {
    listen 443 ssl http2;
    server_name gym.example.com;

    # ssl_certificate /etc/letsencrypt/live/gym.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/gym.example.com/privkey.pem;

    client_max_body_size 2m;

    location ~ ^/accounts/(login|register|password-reset)/ {
        limit_req zone=gym_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
